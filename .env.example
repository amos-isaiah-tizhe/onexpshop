# ── OneXpShop Environment Variables ──────────────────────────────────────────
# HOW TO USE:
#   1. Copy this file:  cp .env.example .env
#   2. Fill in the values below
#   3. The server reads .env automatically via dotenv (npm run dev / npm start)
#   4. On Render: add these as Environment Variables in the dashboard instead
# ─────────────────────────────────────────────────────────────────────────────

# REQUIRED — a long random secret for signing session cookies
# Generate one in Termux: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=

# Set to "production" when deploying to Render, "development" locally
NODE_ENV=development

# Port the server listens on (Render overrides this automatically)
PORT=3000
# ── Paystack ──────────────────────────────────────────────────
# Get these from https://dashboard.paystack.com/#/settings/developers
# Use TEST keys for development, LIVE keys for production
PAYSTACK_PUBLIC_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
PAYSTACK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ── WhatsApp ──────────────────────────────────────────────────
# Your WhatsApp number in international format — no +, no spaces
# Example: Nigerian number 08137631164 becomes 2348137631164
WHATSAPP_NUMBER=